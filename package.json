{
  "name": "recon-tool",
  "version": "1.0.0",
  "private": true,
  "description": "OSINT reconnaissance tool for authorized security research",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "docker:build": "docker build -t recon-tool:latest .",
    "docker:run": "docker run --rm -p 5174:5174 recon-tool:latest",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
