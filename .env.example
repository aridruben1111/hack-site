# Copy to .env and adjust as needed. Consumed by docker-compose / the server.

# Port the Express server listens on (also serves the built client).
PORT=5174

# SSRF protection (recon-security package). When unset/false, targets that
# resolve to private, loopback, link-local or cloud-metadata addresses are
# blocked. Set to true ONLY on a trusted, non-public instance.
# ALLOW_PRIVATE_TARGETS=false

# Port scanner toggle. When set to false the /api/portscan route returns 403.
# Recommended on a public VPS — outbound scanning often breaks provider AUP.
# ENABLE_PORTSCAN=true

# Set when running behind a reverse proxy (nginx/Traefik/Caddy) so the
# rate limiter sees the real client IP. "1" trusts the first proxy hop.
# TRUST_PROXY=1

# Comma-separated allowed CORS origins. Only required when the frontend
# is served from a DIFFERENT origin than the API. In the Docker image the
# client is served same-origin, so this can be left unset.
# CORS_ORIGIN=https://recon.example.com
